generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  ADMIN
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum ChallengeState {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  submissions Submission[]
}
 // el Challenge tiene que tener tags: string[],
model Challenge {
  id          String          @id @default(cuid())
  title       String
  description String
  difficulty  DifficultyLevel
  tags        String[]
  timeLimit   Int
  memoryLimit Int
  state       ChallengeState @default(DRAFT)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  testCases   TestCase[]
}

model TestCase {
  id          String   @id @default(cuid())
  challengeId String
  input       String
  output      String
  index       Int
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, index])
}

model Submission {
  id        String   @id @default(cuid())
  userId    String
  user      User @relation(fields:[userId], references: [id])
  challengeId String 
  language  String
  code      String
  status    String @default("QUEUED")
  score     Int? @default(0)
  timeMsTotal   Int? @default(0)
  createdAt   DateTime @default(now())
  cases SubmissionCase[]
}

model SubmissionCase {
  id           String   @id @default(uuid())
  submissionId String
  caseId       Int
  status       String
  timeMs       Int

  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}
